# Default Suno profile handle (without @)
SUNO_DEFAULT_HANDLE=example_artist

# Optional: default URL type: profile | playlist | song
SUNO_DEFAULT_URL_TYPE=profile

# Optional: override default URL if you don't want to use handle-based profile URL
SUNO_DEFAULT_URL=

# Watch list for `suno-dl --sync`: handles or URLs, comma-separated
SUNO_WATCH=handleA,handleB

# Download settings (defaults: sequential + human-paced jitter)
SUNO_CONCURRENCY=1
SUNO_TIMEOUT_SEC=30
SUNO_MAX_RETRIES=3
SUNO_OUTPUT_DIR=./downloads

# Politeness: minimum seconds between requests to the same host (0 = off)
SUNO_RATE_LIMIT_SEC=1.5

# Optional: override the User-Agent (default already identifies the tool)
SUNO_USER_AGENT=

# Optional JEV/SystemOne decision endpoint for suno-recommend / webui.
# Leave unset to use offline heuristic ranking without a network-model request.
# SUNO_JEV_URL=http://127.0.0.1:8903/v1/evaluate
# SUNO_JEV_MODEL=qwen3-4b-mini-jev

# Media selection (defaults: audio + covers; videos off)
# SUNO_DOWNLOAD_VIDEOS=0
# SUNO_COVERS=1

# Rolling library caps (defaults: off, nothing is deleted)
# SUNO_MAX_TRACKS=20        # keep only the newest N tracks in the archive
# SUNO_MAX_DISK_MB=1024     # cap the archive at N MiB
# SUNO_ROTATE=1             # with a cap set, delete the oldest tracks after a sync
